# Production template. Copy to `.env` on the production host and fill in real values --
# never commit the filled-in file. Differences from .env.example are called out below.

# --- Core ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REQUIRED-generate-with-openssl-rand-hex-32-do-not-reuse-dev-value
ENCRYPTION_KEY=REQUIRED-generate-with-fernet-generate-key-do-not-reuse-dev-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# --- Database ---
# Use a managed Postgres instance (RDS, Neon, Supabase, Cloud SQL, ...) with SSL required.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/socialhub?ssl=require

# --- Deployment URLs ---
# Real, public HTTPS domains. These generate the OAuth redirect URIs you must register in
# the Meta App dashboard (see docs/meta-oauth-setup.md) and the allowed CORS origin.
FRONTEND_URL=https://app.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Leave empty in production -- only used for temporary dev tunnels (ngrok, etc.).
CORS_EXTRA_ORIGINS=

ENABLED_PLATFORMS=facebook,instagram,linkedin,youtube

# --- Storage ---
# Local disk does not survive redeploys/multiple instances -- use R2 (or S3-compatible)
# in production.
STORAGE_BACKEND=r2
LOCAL_UPLOAD_DIR=uploads

R2_ACCOUNT_ID=REQUIRED
R2_ACCESS_KEY_ID=REQUIRED
R2_SECRET_ACCESS_KEY=REQUIRED
R2_BUCKET_NAME=socialhub-media-prod
R2_PUBLIC_URL=https://media.yourdomain.com

# --- Publishing sandbox ---
# MUST be false in production -- true simulates publishes instead of calling real APIs.
PLATFORM_SANDBOX_MODE=false

# --- Facebook (Meta Graph API, "Facebook Login" product) ---
# A production Meta app requires App Review + Business Verification for
# pages_manage_posts before non-admin/tester users can connect accounts.
# See docs/meta-oauth-setup.md for the full checklist.
FACEBOOK_APP_ID=REQUIRED
FACEBOOK_APP_SECRET=REQUIRED
FACEBOOK_GRAPH_VERSION=v21.0

# --- Instagram (Meta's separate "Instagram API with Instagram Login" app) ---
# Requires App Review + Business Verification for instagram_business_content_publish
# before non-admin/tester users can connect accounts.
INSTAGRAM_APP_ID=REQUIRED
INSTAGRAM_APP_SECRET=REQUIRED
INSTAGRAM_GRAPH_VERSION=v21.0

# --- LinkedIn (Company Page posting) ---
# Requires the "Community Management API" product on your LinkedIn app; the member
# connecting must be an ADMINISTRATOR of the Company Page.
LINKEDIN_CLIENT_ID=REQUIRED
LINKEDIN_CLIENT_SECRET=REQUIRED
LINKEDIN_API_VERSION=202604

# --- YouTube ---
# Register the OAuth redirect URI {FRONTEND_URL}/accounts/callback/youtube in the Google
# Cloud Console (APIs & Services -> Credentials) with the YouTube Data API v3 enabled.
YOUTUBE_CLIENT_ID=REQUIRED
YOUTUBE_CLIENT_SECRET=REQUIRED

# --- YouTube Studio uploader ---
# Max video size in MB and upload chunk size in bytes. Videos larger than the generic
# 200MB /media/upload cap must go through the dedicated raw-body upload path.
# YouTube OAuth requests youtube.upload + youtube.readonly + youtube.force-ssl; accounts
# connected before youtube.force-ssl was added must be reconnected to grant the playlist
# write scope (playlists.insert / playlistItems.insert), or playlist writes will fail.
YOUTUBE_MAX_VIDEO_MB=4096
YOUTUBE_UPLOAD_CHUNK_SIZE=10485760

# --- Scheduler ---
SCHEDULER_POLL_SECONDS=60
