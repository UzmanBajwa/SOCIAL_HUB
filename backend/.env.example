# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+asyncpg://socialhub:socialhub@localhost:5432/socialhub

# --- Deployment URLs ---
# Every OAuth redirect URI and the CORS allow-list are derived from these two values, so
# moving from dev -> staging -> prod is an env var change, not a code change.
# Dev:  FRONTEND_URL=http://localhost:5173      BACKEND_URL=http://localhost:8000
# Prod: FRONTEND_URL=https://app.yourdomain.com  BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Extra CORS origins beyond FRONTEND_URL (comma-separated). Only needed for things like a
# temporary ngrok tunnel in development -- leave empty in production.
CORS_EXTRA_ORIGINS=

# Which platforms users can connect in this deployment (comma-separated).
ENABLED_PLATFORMS=facebook,instagram,linkedin,youtube

# --- Storage ---
# local | r2
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# Cloudflare R2 (S3-compatible) - only needed when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=socialhub-media
R2_PUBLIC_URL=

# --- Publishing sandbox ---
# true (development): simulate successful publishes instead of calling real platform APIs.
# false (production): call the real Facebook/Instagram Graph API. See docs/meta-oauth-setup.md.
PLATFORM_SANDBOX_MODE=true

# --- Facebook (Meta Graph API, "Facebook Login" product) ---
# Redirect URI is generated automatically as {FRONTEND_URL}/accounts/callback/facebook --
# register that exact URL in the Meta App's Facebook Login settings. Requires the "Manage
# everything on your Page" use case to be added (App Dashboard -> Use cases) or you'll get
# "Invalid Scopes" for pages_show_list/pages_read_engagement/pages_manage_posts.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Instagram (Meta's "Instagram API with Instagram Login") ---
# This is a SEPARATE Meta app/credentials from Facebook above -- no Facebook Page
# required. Redirect URI is generated automatically as
# {FRONTEND_URL}/accounts/callback/instagram -- register it under the Instagram app's
# "API setup with Instagram login" page. See docs/meta-oauth-setup.md.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v21.0

# --- LinkedIn (Company Page posting via the modern /rest/posts API) ---
# Create an app at linkedin.com/developers, request the "Community Management API"
# product (needed for w_organization_social / r_organization_admin), and add redirect URI
# {FRONTEND_URL}/accounts/callback/linkedin. You must be an ADMINISTRATOR of a LinkedIn
# Company Page to connect it -- personal profile posting isn't supported by design.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Bump this if LinkedIn calls start failing with a version error (rolling ~12mo window).
LINKEDIN_API_VERSION=202604

# --- YouTube (not enabled in this MVP; kept for a future release) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- YouTube Studio uploader ---
# Max video size in MB and upload chunk size in bytes. Videos larger than the generic
# 200MB /media/upload cap must go through the dedicated raw-body upload path.
# 4096 MB = 4GB, YouTube's default account limit.
#
# YouTube OAuth requests the following scopes:
#   youtube.upload       - upload videos
#   youtube.readonly     - read the channel + list playlists
#   youtube.force-ssl    - create playlists + add videos to playlists (playlists.insert /
#                          playlistItems.insert). Added for the playlists feature -- any
#                          account connected BEFORE this scope was requested must be
#                          reconnected (Accounts -> Reconnect) to grant it, or playlist
#                          writes will fail with a 403/400 reconnect message.
YOUTUBE_MAX_VIDEO_MB=4096
YOUTUBE_UPLOAD_CHUNK_SIZE=10485760

# --- Scheduler ---
SCHEDULER_POLL_SECONDS=60
